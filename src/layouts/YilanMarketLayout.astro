---
import { designers, designerRoot, designerPath } from '../lib/yilan-market';
import { boothHtml } from '../../public/puma_oshen_wave/yilan_taiwan_11_07/js/ui/booth-markup.js';
import market from '../../public/puma_oshen_wave/yilan_taiwan_11_07.json';
interface Props { designerId?: string }
const designer = designers.find(profile => profile.id === Astro.props.designerId);
const title = designer ? `${designer.name}｜宜蘭暖流・台派市集` : '宜蘭暖流・台派市集';
const description = designer ? `認識${designer.name}，查看作品與官方社群，走進宜蘭暖流・台派市集探索更多創作。` : '認識宜蘭暖流・台派市集、探索市集地圖。';
const canonical = new URL(designer ? designerPath(designer.id) : designerRoot, Astro.site).href;
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<script is:inline defer src="/assets/analytics.js?v=20261019-content-group"></script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#f82970">
<link rel="icon" href="data:,">
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="MiniCourse">
<meta property="og:locale" content="zh_TW">
<meta property="og:image" content="https://minicourse.dev/puma_oshen_wave/yilan_taiwan_11_07/cover.webp">
<meta property="og:image:alt" content="宜蘭山海與市集插畫">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="https://minicourse.dev/puma_oshen_wave/yilan_taiwan_11_07/cover.webp">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/market.css">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/booth.css?v=20261030-site-data">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/map.css">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/list.css?v=20261026-video3">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/closed.css">
<link rel="stylesheet" href="/puma_oshen_wave/yilan_taiwan_11_07/market.css?v=20261031-actions-row">
</head>
<body>
<div class="app">
  <header class="bar">
    <a class="plaque" href="#/walk" aria-label="宜蘭暖流・台派市集">
      <span>宜蘭暖流・台派市集</span>
    </a>
    <div class="modes" role="group" aria-label="逛法">
      <button type="button" data-mode="walk" aria-pressed="true">逛場子</button>
      <button type="button" data-mode="list" aria-pressed="false">攤位列表</button>
      <button type="button" data-mode="map" aria-pressed="false">市集地圖</button>
    </div>
    <span class="tag close-tag" id="close-tag" hidden></span>
    <a class="link-btn" href="/puma_oshen_wave/stage/">洋流舞台</a>
    <a class="link-btn back-to-map" href="/puma_oshen_wave/">返回地圖</a>
  </header>

  <div class="yilan-event">11 月 7 日（六）15:00–19:00・羅東後火車站旁廣場・以下為線上虛擬攤位 <a href="/puma_oshen_wave/?place=yilan-20261107#map-area">查看地點</a><span class="yl-organizers">主辦單位：{market.market.organizers.join('、')}</span></div>
  <main class="stage" id="stage-walk" hidden>
    <canvas id="walk-canvas" tabindex="0" aria-label="逛場子畫面：按住拖著小人走，點攤位即可查看介紹"></canvas>
    <button type="button" class="where" id="btn-where"><b id="where-hall">宜蘭暖流市集</b><span id="where-aisle"></span><span class="where-switch">換館</span></button>
    <div class="status"><span class="tag tag-zone" id="status-zone"></span><span class="tag" id="status-count"></span></div>
    <p class="hint" id="hint">按住畫面拖著小人走，點一下就走過去，點攤位查看介紹。電腦可以用方向鍵。</p>
    <div class="dock">
      <button type="button" class="btn btn-primary" id="btn-browse" disabled>靠近即可認識攤商</button>
      <button type="button" class="btn" id="btn-next">下一攤</button>
    </div>
  </main>

  <main class="list-mode" id="stage-list"><div class="ls-wrap">
  {designer ? <section aria-label={designer.name} set:html={boothHtml(designer.booth, designer.store).replaceAll('id="booth-title"', 'id="static-designer-title"')} /> : <><h1 class="ls-title">攤位列表</h1><div class="ls-grid">{designers.map(profile => <article class="lc"><div class="lc-heading"><h3 class="lc-name"><a class="lc-open" href={designerPath(profile.id)}>{profile.name}</a></h3></div><p class="lc-owner">攤商 {profile.name}</p><p class="lc-zone">宜蘭暖流市集・攤位</p><a class="btn lc-go" href={designerPath(profile.id)}>看攤位</a></article>)}</div></>}
  </div></main>
  <main class="map-mode" id="stage-map" hidden></main>
  <footer class="app-footer">
    <small>© 2026 MiniCourse｜本站歸 MiniCourse 所有；收錄之攤商資料、作品與商標，其權利歸各攤商或原權利人所有。</small>
  </footer>
  <div class="toast" id="toast" role="status" popover="manual"></div>
</div>

<dialog class="yl-cover" id="yl-cover" aria-labelledby="yl-cover-title" aria-describedby="yl-cover-description">
  <img class="yl-cover-art" src="/puma_oshen_wave/yilan_taiwan_11_07/cover.webp" width="1440" height="720" alt="" fetchpriority="high">
  <div class="yl-cover-content">
    <p class="yl-cover-kicker">2026 · TEAM YILAN, TEAM TAIWAN</p>
    <h1 id="yl-cover-title">宜蘭暖流<br><span>台派市集</span></h1>
    <p id="yl-cover-description" class="yl-cover-details">11 月 7 日（六）15:00–19:00<br>羅東後火車站旁廣場</p>
    <p class="yl-cover-subtitle">{designers.length} 個虛擬攤位，一起逛市集。</p>
    <p class="yl-cover-organizers">主辦單位：{market.market.organizers.join('、')}</p>
    <button class="yl-cover-enter" type="button">進入市集 <span aria-hidden="true">→</span></button>
  </div>
</dialog>

<dialog id="dlg-booth" class="dlg" aria-labelledby="booth-title"></dialog>

<script is:inline type="module" src="/puma_oshen_wave/yilan_taiwan_11_07/js/app.js?v=20261031-actions-row"></script>
</body>
</html>
