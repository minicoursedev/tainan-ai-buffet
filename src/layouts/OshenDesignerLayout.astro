---
import { designers, designerRoot, designerPath } from '../lib/oshen-designers';
import { boothHtml } from '../../public/puma_oshen_wave/designer/js/ui/booth-markup.js';
interface Props { designerId?: string }
const designer = designers.find(profile => profile.id === Astro.props.designerId);
const title = designer ? `${designer.name}｜洋流設計師` : '洋流設計師｜探索設計師、創作作品與線上市集';
const description = designer ? `認識${designer.name}，查看作品與官方社群，走進洋流設計師市集探索更多創作。` : '走進洋流設計師線上市集，瀏覽設計師介紹、創作作品與官方社群。透過設計師列表、地圖與互動攤位，找到喜歡的創作者。';
const canonical = new URL(designer ? designerPath(designer.id) : designerRoot, Astro.site).href;
const exhibitionImage = new URL('/puma_oshen_wave/designer/assets/exhibition-og.png?v=19f09d0c7c56f7bd', Astro.site).href;
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<script is:inline defer src="/assets/analytics.js?v=20261019-content-group"></script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#f82970">
<link rel="icon" href="data:,">
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="MiniCourse">
<meta property="og:locale" content="zh_TW">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{!designer && <>
  <meta property="og:image" content={exhibitionImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="2622">
  <meta property="og:image:height" content="1206">
  <meta property="og:image:alt" content="洋流設計師展逛攤畫面">
</>}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/market.css">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/booth.css?v=20261106-designer-share">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/map.css">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/list.css?v=20261101-profile-links">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/closed.css">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/floating-nav.css?v=20261101">
</head>
<body>
<div class="app">
  <details class="floating-nav" id="floating-nav">
    <summary class="floating-nav-toggle" aria-label="導覽選單"><span aria-hidden="true">☰</span> 選單</summary>
    <nav class="bar" aria-label="導覽選單">
    <a class="plaque" href="#/walk" aria-label="洋流設計師">
      <span>洋流設計師</span>
    </a>
    <div class="modes" role="group" aria-label="逛法">
      <button type="button" data-mode="walk" aria-pressed="true">逛場子</button>
      <button type="button" data-mode="list" aria-pressed="false">設計師列表</button>
      <button type="button" data-mode="map" aria-pressed="false">設計師地圖</button>
    </div>
    <span class="tag close-tag" id="close-tag" hidden></span>
    <a class="link-btn" href="/puma_oshen_wave/stage/">洋流舞台</a>
    <a class="link-btn back-to-map" href="/puma_oshen_wave/">返回地圖</a>
    </nav>
  </details>

  <main class="stage" id="stage-walk" hidden>
    <canvas id="walk-canvas" tabindex="0" aria-label="逛場子畫面：按住拖著小人走，點設計師即可查看介紹"></canvas>
    <button type="button" class="where" id="btn-where"><b id="where-hall">設計師館</b><span id="where-aisle"></span><span class="where-switch">換館</span></button>
    <div class="status"><span class="tag tag-zone" id="status-zone"></span><span class="tag" id="status-count"></span></div>
    <p class="hint" id="hint">按住畫面拖著小人走，點一下就走過去，點設計師查看介紹。電腦可以用方向鍵。</p>
    <div class="dock">
      <button type="button" class="btn btn-primary" id="btn-browse" disabled>靠近即可認識設計師</button>
      <button type="button" class="btn" id="btn-next">下一攤</button>
    </div>
  </main>

  <main class="list-mode" id="stage-list"><div class="ls-wrap">
  {designer ? <section aria-label={designer.name} set:html={boothHtml(designer.booth, designer.store).replaceAll('id="booth-title"', 'id="static-designer-title"')} /> : <><h1 class="ls-title">設計師列表</h1><div class="ls-grid">{designers.map(profile => <article class="lc"><div class="lc-heading"><h3 class="lc-name"><a class="lc-open" href={designerPath(profile.id)}>{profile.name}</a></h3></div><p class="lc-owner">{profile.store.category} {profile.name}</p><p class="lc-zone">設計師館・{profile.store.category}</p><a class="btn lc-go" href={designerPath(profile.id)}>看{profile.store.category}</a></article>)}</div></>}
  </div></main>
  <main class="map-mode" id="stage-map" hidden></main>
  <footer class="app-footer">
    <small class="footer-full">© 2026 MiniCourse｜本站歸 MiniCourse 所有；收錄之設計師資料、作品與商標，其權利歸各設計師或原權利人所有。</small>
    <details class="footer-details"><summary>© 2026 MiniCourse・版權資訊</summary><small>本站歸 MiniCourse 所有；收錄之設計師資料、作品與商標，其權利歸各設計師或原權利人所有。</small></details>
  </footer>
  <div class="toast" id="toast" role="status" popover="manual"></div>
</div>

<dialog id="dlg-booth" class="dlg" aria-labelledby="booth-title"></dialog>
<dialog id="designer-share-dialog" class="dlg designer-share-dialog" aria-labelledby="designer-share-title" aria-describedby="designer-share-description">
  <div class="dlg-head"><h2 id="designer-share-title">分享設計師</h2><button type="button" class="dlg-close" aria-label="關閉分享">×</button></div>
  <div class="dlg-body">
    <p id="designer-share-description">掃描 QRCode，開啟這位設計師的本站連結。</p>
    <img id="designer-share-qr" width="264" height="264" alt="" hidden>
    <a id="designer-share-url" target="_blank" rel="noopener noreferrer"></a>
    <div class="designer-share-actions"><button id="designer-share-copy" type="button" class="btn btn-primary" autofocus>複製連結</button><form method="dialog"><button class="btn">關閉</button></form></div>
    <p id="designer-share-status" class="muted" role="status" aria-live="polite"></p>
  </div>
</dialog>

<script is:inline type="module" src="/puma_oshen_wave/designer/js/app.js?v=20261106-designer-share"></script>
</body>
</html>
