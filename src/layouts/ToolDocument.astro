---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, path } = Astro.props;
---
<BaseLayout title={`${title}｜迷你課`} description={description} canonical={`https://minicourse.dev${path}`}>
  <Header />
  <main id="main" class="wrap tool-document">
    <p>迷你課自用工具</p>
    <h1>{title}</h1>
    <slot />
    <nav aria-label="上傳工具相關資訊"><a href="/youtube-uploader/">工具介紹</a> · <a href="/youtube-uploader/privacy/">隱私權政策</a> · <a href="/youtube-uploader/terms/">使用條款</a></nav>
  </main>
  <Footer />
</BaseLayout>
<style>
.tool-document { max-width: 840px; padding-top: 64px; padding-bottom: 64px; }
.tool-document h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.25; margin-bottom: 32px; }
.tool-document :global(h2) { font-size: 1.35rem; margin-top: 32px; }
.tool-document :global(p), .tool-document :global(li) { line-height: 1.9; }
.tool-document :global(a) { text-decoration: underline; text-underline-offset: 4px; }
.tool-document nav { margin-top: 48px; line-height: 2; }
</style>
