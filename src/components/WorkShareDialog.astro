<dialog id="work-share-dialog" class="dlg work-share-dialog" aria-labelledby="work-share-title" aria-describedby="work-share-description">
  <div class="dlg-head"><h2 id="work-share-title">分享這件作品</h2><button type="button" class="dlg-close" aria-label="關閉作品分享">×</button></div>
  <div class="dlg-body">
    <div class="work-share-preview"><img id="work-share-image" alt="" hidden /><p id="work-share-designer"></p></div>
    <p id="work-share-description">分享作品連結，朋友點開就能看作品、逛攤位。</p>
    <div class="work-share-actions"><button id="work-share-copy" type="button" class="btn btn-primary">複製作品連結</button><button id="work-share-native" type="button" class="btn" hidden>更多分享方式</button></div>
    <p id="work-share-status" class="muted" role="status" aria-live="polite"></p>
    <img id="work-share-qr" width="192" height="192" alt="作品連結 QR Code" hidden />
    <p id="work-share-qr-status" class="muted" role="status"></p>
    <a id="work-share-url" target="_blank" rel="noopener noreferrer"></a>
  </div>
</dialog>
