---
import EventCard from '../components/EventCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LineBreaks from '../components/LineBreaks.astro';
import SkillCard from '../components/SkillCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { events, isUpcoming, skills } from '../lib/data';

const configuredNow = process.env.EVENTS_NOW;
const now = configuredNow ? Date.parse(configuredNow) : Date.now();
if (!Number.isFinite(now)) throw new Error('Invalid EVENTS_NOW');
const upcoming = events.filter(event => isUpcoming(event, now)).sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter(event => !isUpcoming(event, now)).sort((a, b) => b.date.localeCompare(a.date));
const nextEvent = upcoming[0];
const nextEventDate = nextEvent && new Intl.DateTimeFormat('zh-TW', {
  month: 'long',
  day: 'numeric',
  weekday: 'short',
  timeZone: 'Asia/Taipei',
}).format(new Date(`${nextEvent.date}T12:00:00+08:00`));
const description = '台南AI爽是在台南舉辦的 AI 小型聚會，聊 AI 應用與實際使用遇到的問題。查看近期活動、歷次分享、簡報與可以直接使用的 AI Skill。';
---
<BaseLayout
  title="台南AI爽｜台南 AI 聚會，帶著問題一起聊"
  {description}
  canonical="https://minicourse.dev/"
  ogDescription="在台南舉辦的 AI 小型聚會，聊 AI 應用與實際使用遇到的問題。活動資訊、歷次簡報與可以直接使用的 AI Skill，都在這裡。"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '台南AI爽',
    alternateName: 'Tainan AI Buffet',
    url: 'https://minicourse.dev/',
    inLanguage: 'zh-TW',
    description: '在台南舉辦的 AI 小型聚會，聊 AI 應用與實際使用遇到的問題。活動資訊與歷次簡報。',
  }}
>
  <Header home hasUpcoming={upcoming.length > 0} />
  <main id="main">
    {nextEvent ? <section class="featured-event wrap" id="upcoming" aria-labelledby="hero-title">
      <article id={`event-${nextEvent.date}`}>
        <header class="featured-event-header">
          <p class="eyebrow">台南 AI 小型聚會 · 現在接受報名</p>
          <h1 id="hero-title">{nextEvent.title}</h1>
          <p class="featured-summary">{nextEvent.summary}</p>
          <p class="featured-meta"><time datetime={nextEvent.date}>{nextEventDate}</time>{nextEvent.startTime && <> · {nextEvent.startTime}{nextEvent.endTime && `–${nextEvent.endTime}`}</>}<br />{nextEvent.location}</p>
          <div class="hero-actions">
            {nextEvent.registration && <a class="button" href={nextEvent.registration}>{nextEvent.registrationLabel || '活動報名'} <span aria-hidden="true">↗</span></a>}
            {nextEvent.slides && <a class="button" href={`/${nextEvent.slides}`} aria-label={`閱讀 ${nextEvent.title} 簡報`}>閱讀簡報 <span aria-hidden="true">↗</span></a>}
            <a class="text-link" href="#event-details">這場聊什麼 <span aria-hidden="true">↓</span></a>
          </div>
        </header>
        <div class="featured-event-details" id="event-details">
          {nextEvent.paragraphs?.map(paragraph => <p><LineBreaks text={paragraph} /></p>)}
          {nextEvent.participation && <p class="featured-participation"><strong>參加方式</strong><br /><LineBreaks text={nextEvent.participation} /></p>}
        </div>
      </article>
      {upcoming.slice(1).map(event => <EventCard {event} upcoming />)}
    </section> : <section class="hero wrap" aria-labelledby="hero-title">
      <div class="player-card" aria-label="聚會玩家資訊">
          <div class="player-avatar" aria-hidden="true">爽</div>
          <p class="player-label">PLAYER PROFILE</p>
          <h2>任何有問題的人</h2>
          <dl><div><dt>據點</dt><dd>台南</dd></div><div><dt>技能</dt><dd>隨時喊卡</dd></div><div><dt>裝備</dt><dd>正在做的東西</dd></div></dl>
        </div>
      <div class="hero-copy">
        <p class="eyebrow">NEW QUEST AVAILABLE</p>
        <h1 id="hero-title"><span class="hero-name">台南 AI 小型聚會</span>帶著問題，<br />一起聊 AI。</h1>
        <div class="hero-actions">
          <a class="button" href="#archive">查看任務紀錄 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#about">查看聚會規則 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="quest-dialog"><span aria-hidden="true">◆</span><p>把卡住的地方、好奇的事帶來。<br />不需要先懂程式，每個問題都能成為話題。</p></div>
      </div>
    </section>}

    <section class="about-section" id="about" aria-labelledby="about-title"><div class="wrap">
      <div class="section-heading"><p class="eyebrow">HOW WE PLAY</p><h2 id="about-title">聚會怎麼聊？<br />三個規則就夠了。</h2></div>
      <div class="principles">
        <article><span class="number">01 /</span><h3>隨時喊卡</h3><p>聽到不懂的、想再問一步的，不用等到最後。先停一下，把問題聊清楚。</p></article>
        <article><span class="number">02 /</span><h3>一起聚焦</h3><p>有特別在意的主題，就多聊一點。讓討論回到大家真正想了解的事。</p></article>
        <article><span class="number">03 /</span><h3>帶著問題來</h3><p>你遇到了什麼問題？一個卡住的步驟、一個好奇的想法，都可以拿出來聊。</p></article>
      </div>
    </div></section>

    <section class="skills-section wrap" id="skills" aria-labelledby="skills-title">
      <div class="skills-heading"><div><p class="eyebrow">TAKE IT WITH YOU</p><h2 id="skills-title">聊完之後，<br />帶回去直接用。</h2></div><p>我們把聚會裡反覆遇到的問題，<br />整理成可以交給 AI 使用的 Skill。</p></div>
      <div class="skill-list">{skills.length ? skills.map(skill => <SkillCard {skill} />) : <p>實用 Skill 將收錄在這裡。</p>}</div>
    </section>

    <section class="archive-section wrap" id="archive" aria-labelledby="archive-title">
      <div class="archive-heading"><div><p class="eyebrow">PAST GATHERINGS</p><h2 id="archive-title">聊過的，都留在這裡。</h2></div><p>每一場分享，慢慢累積。<br />來過的回顧，沒來過的也能看看。</p></div>
      <div class="event-list">{past.length ? past.map(event => <EventCard {event} upcoming={false} />) : <p>歷次分享將收錄在這裡。</p>}</div>
    </section>
    <section class="closing wrap" aria-labelledby="closing-title"><span class="closing-symbol" aria-hidden="true">?</span><div><h2 id="closing-title">下一次，聊聊你的問題。</h2><p>有想聊的主題、卡住的事情，或對聚會的建議，都可以直接告訴我們。</p><a class="button" href="https://github.com/minicoursedev/tainan-ai-buffet/issues/new">提出想聊的問題 <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer home />
  <script src="/assets/archive.js" defer></script>
</BaseLayout>
