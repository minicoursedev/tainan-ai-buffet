---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/OshenMapLayout.astro';
import { stores, shopPath, httpsUrl, hoursText, type Store } from '../../../../lib/oshen-stores';
export const getStaticPaths = (() => stores.map(store => ({ params: { id: store.id }, props: { store } }))) satisfies GetStaticPaths;
interface Props { store: Store }
const { store } = Astro.props;
const image = store.shopPhoto?.status === 'verified' ? httpsUrl(store.shopPhoto.url) : undefined;
const hours = hoursText(store);
const socialLinks = [['facebook', 'Facebook'], ['instagram', 'Instagram'], ['threads', 'Threads']].map(([key, label]) => ({ label, url: httpsUrl(store.social?.[key]) })).filter(link => link.url);
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${store.address} ${store.name}`)}&travelmode=walking`;
---
<Layout store={store}>
  <Fragment slot="detail">
    <div class="shop-detail-toolbar"><a class="back-to-shops" href="/puma_oshen_wave/">← 返回店家清單</a>{image && <img class="shop-avatar" src={image} alt={`${store.name} 社群頭像`} width="64" height="64" />}</div>
    <div class="detail-content" data-verified={String(store.verification === true)}>
      <div class="detail-heading"><h2>{store.name}</h2><span class="type-tag">{store.category}</span></div>
      {store.category === '洋流服務站' && store.serviceType && <span class="type-tag service-type-tag">{store.serviceType}</span>}
      <p>{store.address}</p>
      {hours && <section class="business-hours"><h3>營業時間</h3><p class="hours-schedule">{hours}</p>{store.openingHours?.note && <p class="hours-note">{store.openingHours.note}</p>}</section>}
      {store.visitNote && <p>{store.visitNote}</p>}
      <div class="detail-bottom"><div class="socials">{socialLinks.length ? socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>) : <span>尚未提供社群連結</span>}</div><a class="directions" href={directions} target="_blank" rel="noopener noreferrer">導航帶我去 ↗</a></div>
      <div class="shop-share"><a href={shopPath(store.id)}>本站店家連結 ↗</a></div>
    </div>
  </Fragment>

</Layout>
