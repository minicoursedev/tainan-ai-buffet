---
import Layout from '../../../layouts/OshenShopLayout.astro';
import { stores, shopPath } from '../../../lib/oshen-stores';
const categories = [...new Set(stores.map(store => store.category))];
---
<Layout title="洋流店家目錄｜我們的洋流地圖" description="探索我們的洋流地圖收錄的店家，依店別查看地址、營業時間與官方社群，找到下一個想去的地方。" path="/puma_oshen_wave/shops/">
  <p class="eyebrow">一起走走</p><h1>下一站，想去哪裡？</h1><p class="muted">{stores.length} 個地方，讓支持成為日常。找間小店，開始今天的散步。</p>
  <nav class="category-links" aria-label="依店別瀏覽">{categories.map((category, index) => <a href={`#category-${index}`}>{category}</a>)}</nav>
  {categories.map((category, index) => <section class="category" id={`category-${index}`}><h2>{category}</h2><div class="grid">{stores.filter(store => store.category === category).map(store => <a class="card" href={shopPath(store.id)}><span class="eyebrow">{store.category}</span><h3>{store.name}</h3><p>{store.address}</p><span>查看店家 ↗</span></a>)}</div></section>)}
</Layout>
